<script>
		$(document).ready(function () {
			  GetViewBag();


	//  function updateTableHeight() {
	// 	 debugger;
	// 	var containerHeight = $('#content-scroll-wrapper').height();

	// 	var theadHeight = $('#fosoulTable thead').outerHeight();
	// 	var tfootHeight = $('#fosoulTable tfoot').outerHeight();

	// 	var tbodyHeight = containerHeight - (theadHeight + tfootHeight);

	// 	$('#fosoulTable tbody').css('height', tbodyHeight + 'px');
	// }

	// updateTableHeight();

	// // اگر کاربر صفحه را تغییر اندازه داد، دوباره تنظیم شود
	// $(window).on('resize', function () {
	// 	updateTableHeight();
	// });
		});

	function GetViewBag() {
		 $.ajax({
			type: "Get",
				url: "/BaseInfo/GetViewBag",
					  data: JSON.stringify(''),
					  contentType: "application/json; charset=utf-8",
					  dataType: "json",
					  success: function (response) {

						 viewBag=response.viewBag;
						 lstNoeFBs=  response.lstNoeFBs;

						 $('#HDFBarAvordUserID').val(viewBag.baId);
						 $('#HDFYear').val(viewBag.year);

							let str = "";
							let selectedId = null;

							$.each(lstNoeFBs, function (index, item) {

							// اولین رادیو انتخاب شود
							let checked = index === 0 ? "checked" : "";

							// اگر اولین آیتم است مقدارش را در متغیر ذخیره کن
							if (index === 0) {
							selectedId = item.id;
							}

						str += `
							<label style="margin-right:10px;">
							<input type="radio" name="radType" onchange="FBChange(${item.id})" value="${item.id}" ${checked}/>
							${item.name}
							</label>
							`;
							});

							$('#HDFNoeFB').val(selectedId);
							$('#divFB').html(str);

						  // var xmlDoc = $.parseXML(response);
						  // var xml = $(xmlDoc);
						  // Table1 = xml.find("Table1");
						  // $.each(Table1, function () {
							 //  $(this).find("BAId").text());
							 //  $(this).find("Year").text());
							 //  //$('#HDFNoeFB').val($(this).find("NoeFB").text());
						  // });
						  GetFosoul();
					  },
					  error: function (response) {
						  toastr.error('خطا', 'خطا');
					  }
		  });
	}

	function FBChange(selectedId)
	{
		$('#HDFNoeFB').val(selectedId);
		GetFosoul();
	}
</script>

