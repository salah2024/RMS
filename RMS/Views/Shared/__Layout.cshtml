<script type="text/javascript">
      $(document).on('click', '.ajax-link', function (e) {
        e.preventDefault();
        var url = $(this).attr('href');
        $('#content-body').html('<div class="text-center p-5">در حال بارگذاری...</div>');

        $.get(url, function (data) {
            $('#content-body').html(data);
        }).fail(function () {
            $('#content-body').html('<div class="text-danger p-5">خطا در بارگذاری محتوا</div>');
        });
    });
</script>
