    <script>
        $(document).ready(function () {
        GetViewBag();
        //GetUserName();
        });
        function GetUserName()
        {
        $.ajax({
        type: "Get",
        url: "/BaseInfo/GetUserName",
        data: JSON.stringify(''),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
        var xmlDoc = $.parseXML(response);
        var xml = $(xmlDoc);
        tblUserName = xml.find("tblUserName");
        $.each(tblUserName, function () {
        $('#HDFUserName').val($(this).find("UserName").text());
        });
        if ($('#HDFUserName').val() == '') {
        toastr.error('دسترسی نامعتبر', 'خطا');
        window.location.href = '../User/LoginPage';
        }
        else
        $('#divWaiting').hide();
        },
        error: function (response) {
        toastr.error('خطا', 'خطا');
        }
        });
        }



        function Exit()
        {
        $.ajax({
        type: "POST",
        url: "/Account/Logout",
        data: JSON.stringify(''),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {

        },
        error: function (response) {
        toastr.error('خطا', 'خطا');
        }
        });
        }




        function GetViewBag() {
        $.ajax({
        type: "Get",
        url: "/BaseInfo/GetViewBag",
        data: JSON.stringify(''),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {

        viewBag=response.viewBag;
        lstNoeFBs=  response.lstNoeFBs;

        $('#HDFBarAvordUserID').val(viewBag.baId);
        $('#HDFYear').val(viewBag.year);
        $('#HDFBAType').val(viewBag.baType);

        $('#spanProjectTitle').html(response.title);

        let str = "";
        let selectedId = null;

        $.each(lstNoeFBs, function (index, item) {

        // اولین رادیو انتخاب شود
        let checked = index === 0 ? "checked" : "";

        // اگر اولین آیتم است مقدارش را در متغیر ذخیره کن
        if (index === 0) {
        selectedId = item.id;
        }

        str += `
        <label style="margin-right:10px;">
        <input type="radio" name="radType" onchange="FBChange(${item.id})" value="${item.id}" ${checked}/>
        ${item.name}
        </label>
        `;
        });

        $('#HDFNoeFB').val(selectedId);
        $('#divFB').html(str);

        GetUnreadCount();

        },
        error: function (response) {
        toastr.error('خطا', 'خطا');
        }
        });
        }

    </script>

</head>

