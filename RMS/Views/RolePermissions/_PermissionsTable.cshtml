@using RMS.Controllers.RolePermissions.Dto
@model List<PermissionCheckboxVm>

@if (Model == null || Model.Count == 0)
{
    <p>مجوزی یافت نشد.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>عنوان مجوز</th>
                <th>گروه مجوز</th>
                <th>✔</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Group</td>
                    <td>
                        <input class="permission-check"
                               type="checkbox"
                               data-pid="@item.PermissionId"
                               @(item.IsChecked ? "checked" : "") />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}