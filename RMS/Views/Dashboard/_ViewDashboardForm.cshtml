@using RMS.Models.Entity
@{
    var BaravordUser = (IEnumerable<clsBaravordUser>)ViewBag.BaravordUser;
}

<style>
    .DashboardMenu {
        cursor: pointer;
        padding: 6px 5px;
        border: 1px solid #101d53;
        border-radius: 5px;
        background-color: #101d53;
        color: #fff;
    }

        .DashboardMenu:hover {
            background-color: #283877;
        }

    .OwnerStyle {
        height: 180px;
        border: 1px solid #101d53;
        border-top: 0px;
        background-color: #fff;
    }

    .DetailsStyle {
        text-align: justify;
        padding: 10px 20px;
        font-size: 14px;
        line-height: 2;
    }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-lg {
        max-width: 684px;
    }

    .form-control {
        height: 25px;
        border: 1px solid #afa1b5;
    }

    .modal-body {
        padding: 0px;
    }

    .spanAllTadilStyle {
        color: blue;
        text-decoration: underline;
    }

        .spanAllTadilStyle:hover {
            text-decoration: underline;
            color: #01016c
        }











    .action-dropdown {
        display: none;
        position: fixed;
        min-width: 180px;
        background: #e4c6ff;
        border: 1px solid #ddd;
        border-radius: 6px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, .2);
        z-index: 999999;
    }

        .action-dropdown a {
            display: block;
            padding: 10px 12px;
            text-decoration: none;
            color: #444;
            text-align: right;
        }

            .action-dropdown a:hover {
                background: #e4b6ff;
                color: #1976d2;
            }


</style>

<script src="~/Scripts/FaniSection/ViewDashboard.js"></script>

<link href="~/scripts/selfstyle/workflowstyle2.css" rel="stylesheet" />

<link href="~/scripts/selfstyle/DashboardStyle.css" rel="stylesheet" />

<style>

    .action-cell {
        position: relative;
        width: 60px;
        text-align: center;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border: none;
        background: #1976d2;
        color: #fff;
        border-radius: 5px;
        cursor: pointer;
    }

    .action-menu {
        position: relative;
        display: inline-block;
    }

    .action-dropdown {
        display: none;
        position: absolute;
        top: 30px;
        left: 0px;
        margin-right: 6px;
        min-width: 180px;
        background: #e4c6ff;
        border: 1px solid #ddd;
        border-radius: 6px;
        box-shadow: 0 5px 15px rgba(0,0,0,.2);
        z-index: 99999;
    }

    .action-menu:hover .action-dropdown {
        display: block;
    }

    .action-dropdown a {
        display: block;
        padding: 10px 12px;
        text-decoration: none;
        color: #444;
        text-align: right;
        transition: .2s;
    }

        .action-dropdown a:hover {
            background: #e4b6ff;
            color: #1976d2;
        }

    .action-dropdown i {
        width: 22px;
    }

</style>

<div class="col-12" style="padding-right:0px;">
    <div class="row">
        <div class="col-12">
            <table id="table" class="table" style="text-align:center;margin-bottom: 0px;max-height: 100px;overflow: auto;">
                <thead>
                    <tr>
                        <td style='display:none'></td>
                        <td width="5%">شماره</td>
                        <td width="35%">
                            <div class="row align-items-center">
                                <div class="col-12 col-md-12 position-relative">
                                    <i class="fa fa-search position-absolute"
                                       style="right:20px; top:50%; transform:translateY(-50%); color:#888;font-size:18px"></i>
                                    <input id="txtSearchTitle"
                                           class="form-control ps-12"
                                           type="text"
                                           placeholder="جستجو بر اساس عنوان پروژه..."
                                           style="border-radius: 10px;" />
                                </div>
                            </div>
                        </td>
                        <td width="30%">فهرست بها</td>
                        <td width="8%">تاریخ</td>
                        <td width="8%">نوع</td>
                        <td width="8%">سال فهرست بها</td>
                        <td style='display:none'></td>
                        <td width="8%">گردش کار</td>
                        <td width="3%">عملیات</td>
                        <td width="3%"></td>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="col-12 table-wrapper" style="max-height:75vh;overflow:auto;">
            <table id="tableBodyTable" class="table" style="text-align:center">
                <tbody id="tableBody">
                </tbody>
            </table>
        </div>
        <div class="col-12">
            <table class="table new-row" style="text-align:center">
                <tr style="background-color: #f4d4ff;">
                    <td style="display:none"></td>
                    <td width="5%"><i class="fa fa-plus SaveRMUStyle"></i></td>
                    <td width="35%"><input id="new_name" class="form-control input" placeholder="عنوان پروژه" /></td>
                    <td width="30%">
                        <div id="new_noeFB" class="checkbox-group">
                            <label><input type="checkbox" checked value="21"> راه، راه‌آهن و باند فرودگاه</label>
                            <label><input type="checkbox" value="22"> راهداری</label>
                            <label><input type="checkbox" value="11"> ابنیه</label>
                            <label><input type="checkbox" disabled value="13"> تاسیسات برقی</label>
                            <label><input type="checkbox" disabled value="12"> تاسیسات مکانیکی</label>
                            <label><input type="checkbox" disabled value="16"> مرمت بناهای تاریخی</label>

                        </div>
                    </td>
                    <td width="8%"></td>
                    <td width="8%">
                    </td>
                    <td width="8%">
                        <select id="new_year" style="width:100%">
                            <option id="1404" value="1404">1404</option>
                            @*<option id="1405" value="1405">1405</option>
                            <option id="1406" value="1406">1406</option>*@
                        </select>
                    </td>

                    <td style="display:none"></td>
                    <td width="6%" style="text-align:center">
                        <button type="button" onclick="SaveInTable(this)" class="ButtonRowsSaveStyle"><i id="iSave" class="fa fa-save SaveRMUStyle"></i></button>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>


<a id="aworkflowSchimaShow" style="display:none" data-toggle="modal" href="#WorkflowSchimaShow"></a>
<div class="modal fade" id="WorkflowSchimaShow" tabindex="-1" role="dialog"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="workflowSchimaTitle"></h2>
                <button id="btnCloseFormNewWSchima" type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="workflowViewer" style="overflow:auto;max-height:500px;margin-top: 20px;
                margin-bottom: 10px;"></div>
            </div>
        </div>
    </div>
</div>


<a id="aCreateBarAvord" style="display:none" data-toggle="modal" href="#CreateBarAvordShow"></a>
<div class="modal fade" id="CreateBarAvordShow" tabindex="-1" role="dialog"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="largeModalLabel">ایجاد برآورد جدید</h2>
                <button id="btnCloseFormNewB" type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
