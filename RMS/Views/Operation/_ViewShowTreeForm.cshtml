    /////////
    function FBChange(selectedId)
    {
        $('#HDFNoeFB').val(selectedId);
        ShowTree();
    }
    // بارگذاری تنبل زیرشاخه‌ها؛ هر شاخه فقط هنگام باز شدن از سرور دریافت می‌شود
    function bindLazyTreeEvents() {
        $('#jstree')
            .off('click.MenuAccordion', 'li > a')
            .on('click.MenuAccordion', 'li > a', function (e) {
                e.preventDefault();
                var $this = $(this);
                var inlineClick = $this.attr('onclick');
                if (inlineClick) {
                    try { eval(inlineClick); }
                    catch (ex) { console.error('Error in tree node action:', ex); }
                }

                var nodeId = $this.attr('id');
                var $target = $('#ul' + nodeId);
                if (!$target.length) return;

                var parentId = nodeId.substring(1);
                var $allNodes = $('#jstree [id^="ula"]');
                var $ancestors = $this.parents('[id^="ula"]');

                if ($target.is(':visible')) {
                    $target.find('[id^="ula"]').addBack().slideUp(250);
                    return;
                }

                var $keepOpen = $ancestors.add($target);
                $allNodes.not($keepOpen).slideUp(250);

                if ($target.data('loaded') === true) {
                    $target.stop(true, true).slideDown(250);
                    return;
                }

                loadTreeChildren(parentId, $target);
            });
    }

    function loadTreeChildren(parentId, $target, isRetry) {
        if (!$target || !$target.length || $target.data('loading') === true) return;
        if ($target.data('loaded') === true && isRetry !== true) return;

        $target.data('loading', true)
            .stop(true, true)
            .html('<li class="tree-loading" style="color:#777;padding:6px 12px;border:0;"><i class="fa fa-spinner fa-spin"></i> در حال بارگذاری...</li>')
            .slideDown(150);

        var requestData = {
            Year: parseInt($('#HDFYear').val()),
            BarAvordUserId: $('#HDFBarAvordUserID').val(),
            OpName: '',
            ParentId: parseInt(parentId)
        };

        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetTree")',
            data: JSON.stringify(requestData),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (data) {
                if (!data || data === 'NOK') {
                    $target.data('loading', false);
                    $target.html('<li style="color:#b94a48;padding:6px 12px;border:0;">دریافت اطلاعات ناموفق بود؛ <a href="#" onclick="retryTreeChildren(\'' + parentId + '\'); return false;">تلاش مجدد</a></li>');
                    return;
                }

                var childItems = data.newOperation || [];
                $target.html(createTree(childItems));
                $target.find('li > a').addClass('OpMenuStyle');
                // زیرشاخه‌های سطح بعد تا زمان کلیک روی همان شاخه بسته بمانند
                $target.find('li > ul').hide();
                $target.data('loading', false).data('loaded', true);

                if (childItems.length === 0) {
                    $target.html('<li style="color:#888;padding:5px 10px;border:0;">موردی برای نمایش وجود ندارد</li>');
                }

                $target.stop(true, true).slideDown(200);
            },
            error: function () {
                $target.data('loading', false);
                $target.html('<li style="color:#b94a48;padding:6px 12px;border:0;">خطا در دریافت زیرشاخه‌ها؛ <a href="#" onclick="retryTreeChildren(\'' + parentId + '\'); return false;">تلاش مجدد</a></li>');
            }
        });
    }

    function retryTreeChildren(parentId) {
        loadTreeChildren(parentId, $('#ula' + parentId), true);
    }

    //////////////
    function ShowTree() {
    plugin = ['wholerow'];
    var vardata = new Object();
    Year = $('#HDFYear').val();
    //NoeFBId = $('#HDFNoeFB').val();
    BarAvordUserId = $('#HDFBarAvordUserID').val();

    vardata.Year =parseInt(Year);
    //vardata.NoeFBId = parseInt(NoeFBId);
    vardata.BarAvordUserId = BarAvordUserId;
    vardata.OpName = '';
    $.ajax({
    type: "POST",
        url: "@Url.Action("GetTree")",
        data: JSON.stringify(vardata),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {

        NewOperation=data.newOperation;
        BaravordType=data.baravordType;

    var html = createTree(NewOperation);

    $('#jstree').html(html);
    $('#jstree li a').addClass('OpMenuStyle');
    bindLazyTreeEvents();

    $('#jstree li ul').hide();
    },
    error: function (response) {
    toastr('danger', 'خطا', 'مشکلی بوجود آمده، مجددا بعدا امتحان نمایید')
    }
    });
    }

    //////////////
    function GetTreeForOneOperation() {
    debugger;
    plugin = ['wholerow'];
    var vardata = new Object();
    Year = $('#HDFYear').val();
    NoeFBId = $('#HDFNoeFB').val();


    BarAvordUserId = $('#HDFBarAvordUserID').val();

    vardata.Year = parseInt(Year);
    vardata.NoeFBId = parseInt(NoeFBId);
    vardata.BarAvordUserId = BarAvordUserId;
    vardata.OpName = 'transport';
    $.ajax({
    type: "POST",
    url: "@Url.Action("GetTreeForOneOperation")",
    data: JSON.stringify(vardata),
    contentType: "application/json; charset=utf-8",
    dataType: "json",
    success: function (data) {
    AllOperation=data.allOperation;
    OperationId=data.operationId;
    debugger;
    var html= createTree(AllOperation,OperationId);

    $('#ula1404229').html(html);
    $('#ula1404229 li a').each(function () {
    $(this).addClass('OpMenuStyle');
    $(this).click(function () {
    CurrentId = $(this).attr('id');
    ParentId = $(this).parent().parent();
    $("#" + ParentId.attr('id') + " [id^='ula']").each(function () {
    if ($(this).attr('id') != ('ul'+CurrentId))
    $(this).slideUp(1000);
    });
    $('#ul' + $(this).attr('id')).toggle(1000);
    });
    });
    $('#ula1404229 li ul').each(function () {
    $(this).hide();
    });
    },
    error: function (response) {
    toastr('danger', 'خطا', 'مشکلی بوجود آمده، مجددا بعدا امتحان نمایید')
    }
    });
    }

    function SetNoeFB(OpId,NoeFB,event)
    {
    if (event) {
    event.stopPropagation();
    event.preventDefault();
    }

    $('#HDFNoeFB').val(NoeFB);


    debugger;
    return true;
    }

</script>

