	// 	// ⛔️ دیگر eval نمی‌کنیم
	// 	// OperationClick همان onclick اصلی است که فقط یک‌بار اجرا شده

	// 	var realId = currentId.replace('a','');
	// 	var $target = $('#ula' + realId);
	// 	if (!$target.length) return;

	// 	var $allNodes = $('#jstree [id^="ula"]');
	// 	var $ancestors = $a.parents('[id^="ula"]');

	// 	if ($target.is(':visible')) {
	// 		$target.find('[id^="ula"]').addBack().slideUp(500);
	// 	} else {
	// 		var $keepOpen = $ancestors.add($target);
	// 		$allNodes.not($keepOpen).slideUp(500);
	// 		$keepOpen.slideDown(500);
	// 	}
	// });


	$('#jstree li a').each(function () {

		var $a = $(this);

		$a.addClass('OpMenuStyle');

		$a.off('click.MenuAccordion').on('click.MenuAccordion', function (e) {

			e.preventDefault(); // جلوگیری از رفتار پیش‌فرض

			var $this = $(this);
			var currentId = $this.attr('id');
			var $target = $('#ul' + currentId);

			// 🔹 اجرای تابع onclick قبل از بازکردن نود
			var inlineClick = $this.attr("onclick");
			if (inlineClick) {
				try {
					eval(inlineClick);   // اجرای کد موجود در onclick
				} catch (ex) {
					console.error("Error in onclick:", ex);
				}
			}

			if (!$target.length) return;

			var $allNodes = $('#jstree [id^="ula"]');
			var $ancestors = $this.parents('[id^="ula"]');

			if ($target.is(':visible')) {
				$target.find('[id^="ula"]').addBack().slideUp(500);
			} else {
				var $keepOpen = $ancestors.add($target);
				$allNodes.not($keepOpen).slideUp(500);
				$keepOpen.slideDown(500);
			}
		});

	});

				   $('#jstree li ul').each(function () {
					   $(this).hide();
				   });
				},
