	function ShowConditionDes(ConditionContextId)
	   {
		   var vardata = new Object();
		   vardata.ConditionContextId = ConditionContextId;

		 $.ajax({
		   type: "POST",
		   url: "/BaseInfo/GetConditionDes",
		   data: JSON.stringify(vardata),
		   contentType: "application/json; charset=utf-8",
		   dataType: "json",
		   success: function (response) {
			   debugger;
				  $('#divConditionDesShow').html(response.des);
				  $('#TitleConditionDesShow').html(response.titleDes);
				  $('#aConditionDesShow').click();

		   },
		   error: function (response) {
			   toastr.error('مشکل در حذف اضافه بها', 'خطا');
		   }
	   });
