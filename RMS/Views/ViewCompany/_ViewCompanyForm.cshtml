@using RMS.Models.Entity
@using static RMS.Models.Common.EnumForEntity
@model IEnumerable<clsCompany>

<div style="margin-top:80px">
    <div class="container mt-4" dir="rtl">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>لیست شرکت‌ها</h4>

            <!-- دکمه درج جدید: می‌فرستد به فرم RegisterInPanel -->
            <a asp-controller="RegisterCompanyInPanel"
               asp-action="Index"
               class="btn btn-primary">
                + شرکت جدید
            </a>
        </div>

        <table class="table table-striped table-bordered table-sm text-center">
            <thead class="table-light">
                <tr>
                    <th>ردیف</th>
                    <th>نام شرکت</th>
                    <th>نام مدیرعامل</th>
                    <th>نام خانوادگی مدیرعامل</th>
                    <th>شناسه ملی</th>
                    <th>تلفن</th>
                    <th>موبایل</th>
                    <th>فاکس</th>
                    <th>ایمیل</th>
                    <th>آدرس</th>
                    <th>نوع شرکت</th>
                    <th>پرسنل شرکت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.CompanyName</td>
                        <td>@item.ManagementFirstName</td>
                        <td>@item.ManagementLastName</td>
                        <td>@item.CompanyNationalCode</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.MobileNumber</td>
                        <td>@item.FaxNumber</td>
                        <td>@item.Email</td>
                        <td>@item.Address</td>
                        <td>@(item.CompanyType == CompanyType.KarFarma ? "کارفرما" : item.CompanyType == CompanyType.Moshaver ? "مشاور" : "پیمانکار")</td>
                        <td>
                            <a asp-controller="RegisterInPanel"
                               asp-action="Index"
                               asp-route-companyId="@item.ID"
                               class="btn btn-sm btn-warning ajax-link">
                                افزودن
                            </a>
                            <a asp-controller="Users" asp-action="UserList"
                               asp-route-id="@item.ID"
                               asp-route-companyId="@item.ID"
                               class="btn btn-sm btn-warning ajax-link">
                                مشاهده
                            </a>
                        </td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.ID"
                               class="btn btn-sm btn-warning ajax-link">
                                ویرایش
                            </a>
                            <form asp-action="Delete"
                                  asp-route-id="@item.ID"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('از حذف این شرکت مطمئن هستید؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>