@using RMS.Models.Entity
@using static RMS.Models.Common.EnumForEntity
@model IEnumerable<clsUserDetail>

<div class="container mt-4" dir="rtl">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>لیست شرکت‌ها</h4>

        <!-- دکمه درج جدید: می‌فرستد به فرم RegisterInPanel -->
        <a asp-controller="RegisterInPanel"
           asp-action="Index"
           class="btn btn-primary">
            + شرکت جدید
        </a>
    </div>

    <table class="table table-striped table-bordered table-sm text-center">
        <thead class="table-light">
            <tr>
                <th>ردیف</th>
                <th>نام شرکت</th>
                <th>نام مدیرعامل</th>
                <th>شناسه ملی</th>
                <th>نام کاربری</th>
                <th>موبایل</th>
                <th>آدرس</th>
                <th>نوع کاربر</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @{
                var i = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@item.CompanyName</td>
                    <td>@item.CEOName</td>
                    <td>@item.NationalCode</td>
                    <td>@item.User?.UserName</td>
                    <td>@item.User?.PhoneNumber</td>
                    <td>@item.Address</td>
                    <td>@(item.userType == UserType.Legal ? "حقوقی" : "حقیقی")</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.ID"
                           class="btn btn-sm btn-warning ajax-link">
                            ویرایش
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@item.ID"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('از حذف این شرکت مطمئن هستید؟');">
                                حذف
                            </button>
                        </form>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
