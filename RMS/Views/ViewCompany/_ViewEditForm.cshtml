@using RMS.Models.Entity
@model clsCompany

<div class="container mt-4" dir="rtl">
    <h4>ویرایش اطلاعات شرکت</h4>
    <hr />

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ID" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label">نام شرکت</label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ManagementFirstName" class="form-label">نام مدیرعامل</label>
                <input asp-for="ManagementFirstName" class="form-control" />
                <span asp-validation-for="ManagementFirstName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ManagementLastName" class="form-label">نام خانوادگی مدیرعامل</label>
                <input asp-for="ManagementLastName" class="form-control" />
                <span asp-validation-for="ManagementLastName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CompanyNationalCode" class="form-label">شناسه ملی</label>
                <input asp-for="CompanyNationalCode" class="form-control" />
                <span asp-validation-for="CompanyNationalCode" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PostalCode" class="form-label">کد پستی</label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label">تلفن</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label">آدرس</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">ذخیره</button>
            <a asp-action="Index" class="btn btn-secondary ajax-link">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
