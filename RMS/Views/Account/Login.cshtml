@model LoginViewModel

@{
    ViewData["Title"] = "ورود به سیستم";
}

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- لود فونت ایران‌سنس از Fontcdn -->
    <link href="https://cdn.fontcdn.ir/Font/Persian/IRANSans/IRANSans.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="~/scripts/selfstyle/loginstyle.css" rel="stylesheet" />

    <style>
            body {
                font-family: 'IRANSans', sans-serif;
                direction: rtl;
                min-height: 100vh;
                background-image: url('@Url.Content("~/assets/img/photos/login.png")');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                display: flex;
                justify-content: center;
                align-items: center;
                position: relative;
            }
    </style>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const userName = document.getElementById("UserName");
                const password = document.getElementById("Password");

                userName?.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        password.focus();
                    }
                });

            });
    </script>

</head>
<body>

    <div class="login-wrapper">

        <div class="login-card">
            <div class="login-title-wrapper">
                <div class="main-title">
                    ساکار
                </div>

                <div class="sub-title">
                    سامانه مدیریت هوشمند پروژه
                </div>
            </div>

            <form asp-action="Login" asp-controller="Account" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <div class="input-icon">
                        <i class="bi bi-person"></i>
                        <input asp-for="UserName" id="UserName"
                               class="form-control custom-input"
                               placeholder="نام کاربری">
                    </div>

                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">

                    <div class="input-icon">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" id="Password"
                               type="password"
                               class="form-control custom-input"
                               placeholder="رمز عبور">
                    </div>

                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4 d-flex align-items-center">
                    <input asp-for="RememberMe" class="form-check-input ms-2" />
                    <label asp-for="RememberMe" class="form-check-label">
                        مرا به خاطر بسپار
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    ورود به سیستم
                </button>

            </form>

           
            <div class="footer-links">
                <a href="/Account/Register">
                    ثبت نام
                </a>
                |
                <a href="#">فراموشی رمز عبور</a>


            </div>
            <div class="designer-box">
                طراحی و توسعه توسط
                <strong>
                    شرکت مهندسین مشاور پاد راه رضوان
                </strong>
            </div>
        </div>

    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>
