@model LoginViewModel

@{
	ViewData["Title"] = "ورود به سیستم";
}

@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="fa">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewData["Title"]</title>
	<!-- لود فونت ایران‌سنس از Fontcdn -->
	<link href="https://cdn.fontcdn.ir/Font/Persian/IRANSans/IRANSans.css" rel="stylesheet" />

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
	<style>
		body {
			font-family: 'IRANSans', Arial, sans-serif;
			direction: rtl;
			margin: 0;
			padding: 0;
			background-color: #1c0473;
		}

		.login-container {
			max-width: 500px;
			margin: 150px auto;
			background-color: #fff;
			padding: 30px;
			border-radius: 8px;
			box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
		}

		.login-header h1 {
			padding: 20px;
			font-size: 22px;
			margin-bottom: 20px;
		}

		.form-group {
			margin-bottom: 15px;
		}

		.login-btn {
			background-color: #007bff;
			color: white;
			width: 100%;
			padding: 10px;
			border: none;
			border-radius: 5px;
		}

			.login-btn:hover {
				background-color: #0056b3;
			}

		.footer-links {
			text-align: center;
			margin-top: 15px;
		}

			.footer-links a {
				color: #007bff;
			}

				.footer-links a:hover {
					text-decoration: underline;
				}

		/* تنظیمات برای چک‌باکس "مرا به خاطر بسپار" */
		.form-check {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.form-check-label {
			margin-left: 10px;
			font-size: 14px;
		}
	</style>
</head>
<body>

<div class="container">
    <!-- فرم ورود -->
    <div class="login-container">
        <!-- هدر داخل فرم -->
        <div class="login-header">
            <h1>به سامانه مدیریت هوشمند پروژه ساکار خوش آمدید</h1>
        </div>

        <form asp-action="Login" asp-controller="account" method="post">
            @* نمایش خطاهای کلی مدل *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="UserName">نام کاربری</label>
                <input asp-for="UserName" class="form-control" placeholder="نام کاربری خود را وارد کنید" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">رمز عبور</label>
                <input asp-for="Password" class="form-control" placeholder="رمز عبور خود را وارد کنید" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- چک‌باکس "مرا به خاطر بسپار" -->
            <div class="form-check mt-2 mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">مرا بخاطر بسپار</label>
            </div>

            <button type="submit" class="login-btn">ورود به سیستم</button>
        </form>

        <div class="footer-links">
            <a href="#" class="text-decoration-none">رمز عبور خود را فراموش کرده‌اید؟</a> |
            <a href="/Account/Register" class="text-decoration-none">ثبت‌ نام</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

</body>
</html>
